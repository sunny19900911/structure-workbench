# 将本文件复制为 .env.local，再填入你自己的 DeepSeek API Key。
# .env.local 已加入 .gitignore，不要把密钥发给他人或写入 HTML/JavaScript。
DEEPSEEK_API_KEY=请在这里填写你的_API_Key

# 当前官方接口支持的模型名称可能随版本调整，可在这里切换。
DEEPSEEK_MODEL=deepseek-v4-pro

# 一般无需修改。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 计算书输入目录；目录内的原始 Word 始终只读。
CALCBOOK_SOURCE_DIR=E:\600-工作台数据库\610-待处理\01-计算书

# 可选。未填写时优先使用 Codex 工作区依赖中的 Python，再回退到 PATH 中的 python。
CALCBOOK_PYTHON=
